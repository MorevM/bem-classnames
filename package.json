{
	"name": "@morev/bem-classnames",
	"description": "Simple utility for generating classnames according to the BEM methodology.",
	"type": "module",
	"private": false,
	"sideEffects": false,
	"version": "1.1.2",
	"packageManager": "pnpm@11.20.0",
	"license": "MIT",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"author": {
		"name": "Maxim Morev",
		"email": "max.seainside@gmail.com"
	},
	"homepage": "https://github.com/MorevM/bem-classnames#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/MorevM/bem-classnames"
	},
	"keywords": [
		"BEM",
		"classnames"
	],
	"files": [
		"dist"
	],
	"exports": {
		"import": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		}
	},
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"prepare": "lefthook install",
		"release": "release-it --disable-metrics",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest",
		"build": "tsup",
		"benchmark": "pnpm run build && node benchmarks/bem-classnames.benchmark.mjs"
	},
	"dependencies": {
		"@morev/utils": "^3.12.1"
	},
	"devDependencies": {
		"@morev/commitlint-config": "^0.2.2",
		"@morev/eslint-config": "^36.3.2",
		"@release-it/conventional-changelog": "^8.0.1",
		"eslint": "^9.18.0",
		"lefthook": "^1.10.3",
		"release-it": "^18.1.1",
		"tsup": "^8.3.5",
		"typescript": "^5.7.3",
		"vitest": "^2.1.8"
	}
}
